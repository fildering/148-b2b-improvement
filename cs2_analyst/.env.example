# Groq API Key (จำเป็น — ฟรี! 14,400 req/วัน)
# สมัครที่ https://console.groq.com/ → "API Keys" → "Create API Key"
GROQ_API_KEY=gsk_your_groq_api_key_here

# FACEIT API Key (optional — ฟรี! สำหรับ auto-download demos)
# สมัครที่ https://developers.faceit.com/
FACEIT_API_KEY=your_faceit_api_key_here
